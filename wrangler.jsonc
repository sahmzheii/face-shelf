{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "face-shelf",
	"main": "./src/index.js",
	"compatibility_date": "2026-10-29",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/webhooks/*",
			"/stocks/event/*",
			"/media/events/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "face-shelf-db",
			"database_id": "dd4b763c-7edf-4ee6-955d-a8460fc858c9"
		}
	],
	"r2_buckets": [
		{ "binding": "EVENT_IMAGES", "bucket_name": "face-shelf-event-images" }
	],
	"triggers": { "crons": ["0 * * * *"] },
	"vars": {
		"FB_GRAPH_VERSION": "v26.0"
	}
}
