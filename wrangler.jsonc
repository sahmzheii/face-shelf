{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "face-shelf",
	"main": "./src/index.js",
	"compatibility_date": "2026-10-29",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/webhooks/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "face-shelf-db",
			"database_id": "dd4b763c-7edf-4ee6-955d-a8460fc858c9"
		}
	],
	"vars": {
		"FB_GRAPH_VERSION": "v26.0"
	}
}
