{
  "name": "face-shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 4173",
    "start": "wrangler dev --port 4173",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute face-shelf-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute face-shelf-db --remote --file=./schema.sql"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
